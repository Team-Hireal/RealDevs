{
  "version": 2,
  "builds": [
    {
      "src": "apps/web/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "app.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/web/api/auth.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/web/api/repos.py",
      "use": "@vercel/python"
    },
    {
      "src": "apps/web/api/dashboard.py",
      "use": "@vercel/python"
    }
  ],
  "routes": [
    {
      "src": "/api/repos/selected",
      "dest": "/apps/web/api/repos.py"
    },
    {
      "src": "/api/dashboard/daily-commits",
      "dest": "/apps/web/api/dashboard.py"
    },
    {
      "src": "/api/(.*)",
      "dest": "/app.py"
    },
    {
      "src": "/(.*)",
      "dest": "/apps/web/$1"
    }
  ],
  "functions": {
    "app.py": {
      "maxDuration": 60
    },
    "apps/web/api/auth.py": {
      "maxDuration": 60
    },
    "apps/web/api/repos.py": {
      "maxDuration": 60
    },
    "apps/web/api/dashboard.py": {
      "maxDuration": 60
    }
  },
  "env": {
    "PYTHONPATH": "."
  }
}

