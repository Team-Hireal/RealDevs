{
  "version": 2,
  "builds": [
    {
      "src": "apps/api/index.py",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "apps/api/index.py"
    },
    {
      "src": "/(.*)",
      "dest": "apps/api/index.py"
    }
  ],
  "env": {
    "PYTHONPATH": "."
  }
}

